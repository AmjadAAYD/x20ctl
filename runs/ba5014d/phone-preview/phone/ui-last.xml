used="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[478,175][2257,1080]"><node index="0" text="" resource-id="" class="StackPanel" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[478,175][2257,398]"><node index="0" text="Before you scan" resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[478,175][2257,292]" /><node index="1" text="This is a full controller scan: you'll be guided through every button, stick and trigger, one step at a time, while X20CTL records exactly what the controller reports. Here is what it does and what to expect." resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[478,306][2257,398]" /></node><node index="1" text="" resource-id="" class="UniformGrid" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[478,436][2257,1080]"><node index="0" text="" resource-id="" class="Border" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[478,436][1334,879]"><node index="0" text="" resource-id="" class="StackPanel" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[527,485][1285,830]"><node index="0" text="Reads, never writes" resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[527,485][1285,536]" /><node index="1" text="The scan only listens to what the controller already tells Linux. No settings, lighting, vibration or firmware are touched." resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[527,547][1285,668]" /></node></node><node index="1" text="" resource-id="" class="Border" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1368,436][2224,879]"><node index="0" text="" resource-id="" class="StackPanel" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1417,485][2175,830]"><node index="0" text="Buttons, sticks and triggers" resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1417,485][2175,536]" /><node index="1" text="Every button is pressed and held so its exact timing is recorded; sticks are rolled for their full range and their resting drift; triggers are pulled for their full travel." resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1417,547][2175,708]" /></node></node><node index="2" text="" resource-id="" class="Border" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[478,913][1334,1080]"><node index="0" text="" resource-id="" class="StackPanel" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[527,962][1285,1080]"><node index="0" text="Battery" resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[527,962][1285,1013]" /><node index="1" text="Read from the kernel's power_supply entry for the controller, when the connection reports one. Nothing is ever sent to it." resource-id="" class="TextBlock" package="io.github.amjadaayd.x20ctl" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[527,1024][1285,1080]" /></node></node><node index="3" text="" resource-id="" class="Border" packa