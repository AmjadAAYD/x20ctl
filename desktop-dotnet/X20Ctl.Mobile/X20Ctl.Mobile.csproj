<Project Sdk="Microsoft.NET.Sdk">
  <!-- X20CTL for Android phones. Diagnostics first: input tester, read-only Bluetooth scan, Write scan from the phone's own log.
       Sending settings to a controller is locked (X20Ctl.Mobile.Core/GattPolicy.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>X20Ctl.Mobile</RootNamespace>
    <ApplicationTitle>X20CTL</ApplicationTitle>
    <ApplicationId>io.github.amjadaayd.x20ctl</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The shared Zone code serialises with reflection; keep every type rather than risk a trimmed-away member. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../X20Ctl.Mobile.Core/X20Ctl.Mobile.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- copies of X20Ctl.Product/Brand/x20ctl-icon.png and x20ctl-mark.png: Android resource names allow no hyphens -->
    <MauiIcon Include="Resources/AppIcon/appicon.png" Color="#0B0D12" ForegroundScale="0.7" />
    <MauiSplashScreen Include="Resources/Splash/splash.png" Color="#0B0D12" BaseSize="128,128" />
  </ItemGroup>
</Project>
