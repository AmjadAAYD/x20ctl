<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the Linux Studio's screens to PNGs with Avalonia's headless platform: no window is ever shown, on any OS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../X20Ctl.Linux/X20Ctl.Linux.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>
</Project>
