<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>x20ctl-studio</AssemblyName>
    <RootNamespace>X20Ctl.Linux</RootNamespace>
    <Version>4.1.0-preview.6</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../X20Ctl.Zone/X20Ctl.Zone.csproj" />
    <Content Include="../../x20ctl/controllers/catalog.json" Link="Data/catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="../../src/assets/controllers/*/native/front-full.png" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
