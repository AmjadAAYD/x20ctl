<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- English UI only: the framework's 13 other resource languages added 15 MB to the download -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>X20Ctl</AssemblyName>
    <ApplicationIcon>Brand/x20ctl.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>4.1.0-preview.6</Version>
    <!-- the engine sits beside X20Ctl.exe; a one-exe build (-p:EngineBesideExe=false -p:IncludeAllContentForSelfExtract=true) packs it in -->
    <EngineBesideExe Condition="'$(EngineBesideExe)' == ''">true</EngineBesideExe>
    <!-- release builds (-p:ElevateAtLaunch=true) ask for administrator permission when opened, so PC mode can install its drivers; dev builds don't -->
    <ApplicationManifest Condition="'$(ElevateAtLaunch)' == 'true'">app.elevated.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is used only for the tray NotifyIcon; keep its namespaces out of the WPF code -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../artifacts/product-engine-phase/native-build/Release/x20ctl-engine.exe" Link="x20ctl-engine.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="$(EngineBesideExe)" />
    <ProjectReference Include="../X20Ctl.Zone/X20Ctl.Zone.csproj" />
    <!-- the managed ViGEm client only: it talks to the ViGEmBus driver, which PC mode installs on first use -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <!-- the X20CTL mark in white (tools/build_brand_mark.py); the intro draws the same mark in red -->
    <Resource Include="Brand/x20ctl-mark.png" Link="Assets/brand.png" />
    <Content Include="../../x20ctl/controllers/catalog.json" Link="Data/catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/controllers/x20/rear-geometry.json" Link="Data/x20-rear.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/controllers/control-shapes.json" Link="Data/control-shapes.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../src/assets/controllers/**/native/*.png" Link="Assets/native/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../src/assets/controllers/native-layers.json" Link="Data/native-layers.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- the opening sound, made from sine waves by tools/build_intro_sound.py -->
    <Content Include="Brand/intro.wav;Brand/intro-audio-provenance.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- the guides Agent XCTL answers app questions from (M5) -->
    <Content Include="../../README.md;../../IF-YOUR-CONTROLLER-ISNT-WORKING.md;../../PRIVACY.md" Link="Help/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- PC mode's two installers (ViGEmBus, HidHide; see vendor/drivers/README.md), carried inside the exe when present -->
    <Content Include="../../vendor/drivers/*.exe" Link="drivers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../vendor/drivers')" />
    <Content Include="../../tools/linux_controller_check/x20ctl-check.py" Link="Tools/linux/x20ctl-check.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/controllers/lighting.json" Link="Data/lighting.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/controllers/vibration-outlines.json" Link="Data/vibration-outlines.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/controllers/outlines.json" Link="Data/outlines.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/controllers/**/haptics-geometry.json" Link="Data/haptics/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireLiveInputEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../artifacts/product-engine-phase/native-build/Release/x20ctl-engine.exe')" Text="Live input engine is missing. Build native-core with CMake into artifacts/product-engine-phase/native-build (Release, target x20ctl-engine) before building the app. A build without live input must not ship." />
  </Target>
</Project>
