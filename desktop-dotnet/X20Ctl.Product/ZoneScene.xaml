<UserControl x:Class="X20Ctl.Product.ZoneScene" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:X20Ctl.Product" Loaded="OnLoaded" Unloaded="OnUnloaded" MouseMove="OnMouseMove" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- the Controller Zone after the owner's mock (10 Oct 2026), kept navy: faceted glass backdrop, a quiet header,
       "Players" with an All players pill, the four controller cards, and the button hints along the bottom -->
  <Border x:Name="OuterFrame" CornerRadius="16" BorderBrush="#3C768DAF" BorderThickness="1" Background="{StaticResource Ink}">
    <Grid x:Name="Surface" ClipToBounds="True">
      <local:FacetBackdrop />
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
        <Border BorderBrush="#1EFFFFFF" BorderThickness="0,0,0,1" Padding="24,0,16,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="46" Height="46" CornerRadius="12" BorderBrush="#40FFFFFF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1A2232" Offset="0" /><GradientStop Color="#FF0B1019" Offset="1" /></LinearGradientBrush></Border.Background><Image Source="/Assets/brand.png" Width="26" Height="26" /></Border>
              <TextBlock Text="X20CTL" FontFamily="{StaticResource DS.FontDisplay}" FontSize="24" FontWeight="Bold" Margin="20,0,18,0" VerticalAlignment="Center" />
              <Border Width="1" Height="22" Background="#33FFFFFF" VerticalAlignment="Center" />
              <TextBlock Text="Controller Zone" FontFamily="{StaticResource DS.FontDisplay}" FontSize="17" Foreground="#A9B6CA" Margin="18,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ToolsButton" Style="{StaticResource DS.Secondary}" MinHeight="40" Height="40" Padding="18,0" FontSize="15" FontWeight="SemiBold" Margin="0,0,12,0" Click="Settings" ToolTip="Replay intro, Controller Check, About and more (Menu button)" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Tools">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,1,10,0" /><TextBlock Text="Tools" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="SupportButton" Click="Support" Style="{StaticResource DS.SupportPill}" MinHeight="40" Height="40" Padding="18,0" FontSize="15" FontWeight="SemiBold" Margin="0,0,22,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Support">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,1,10,0" /><TextBlock Text="Support" VerticalAlignment="Center" /></StackPanel>
              </Button>
              
              <Button Content="&#xE921;" Click="Minimize" Style="{StaticResource ChromeAction}" KeyboardNavigation.TabIndex="20" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" />
              <Button x:Name="MaximizeButton" Content="&#xE922;" Click="Maximize" Style="{StaticResource ChromeAction}" KeyboardNavigation.TabIndex="21" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fullscreen or window" />
              <Button Content="&#xE8BB;" Click="Close" Style="{StaticResource ChromeAction}" KeyboardNavigation.TabIndex="22" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="Workspace" Grid.Row="1" Margin="56,34,56,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="Heading"><TextBlock Text="Players" Style="{StaticResource DS.Display}" FontWeight="Bold" FontSize="44" /><TextBlock Text="Choose a player to set up its controller" Style="{StaticResource DS.Body}" FontSize="17" Foreground="#93A2B8" Margin="2,2,0,0" /></StackPanel>
            <Button x:Name="OverviewBack" Grid.Column="1" Style="{StaticResource DS.Secondary}" MinHeight="46" Height="46" Padding="22,0" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" Click="BackToOverview" AutomationProperties.Name="Return to four-player overview">
              <StackPanel Orientation="Horizontal"><TextBlock x:Name="OverviewIcon" Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,1,12,0" /><TextBlock x:Name="OverviewLabel" Text="Selected player" VerticalAlignment="Center" /></StackPanel>
            </Button>
          </Grid>
          <Canvas x:Name="DockStage" Grid.Row="1" Margin="0,28,0,0" ClipToBounds="False" SizeChanged="OnStageSizeChanged">
            <Ellipse x:Name="FocusBloom" Width="470" Height="340" Opacity="0" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#281A9FFF" Offset="0" /><GradientStop Color="#001A9FFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
          </Canvas>
          <!-- spoken status for screen readers; the cards themselves carry the state visually -->
          <TextBlock x:Name="FeedbackText" Grid.Row="1" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" Text="Select any player. All four docks begin equal." AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Border Grid.Row="2" BorderBrush="#1CFFFFFF" BorderThickness="0,1,0,0" Padding="28,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NavigationHint" Text="" Visibility="Collapsed" /><StackPanel x:Name="ZoneHints" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border CornerRadius="13" Height="26" Padding="12,0" Background="#14FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock x:Name="ProvenanceText" Text="SIMULATION" FontFamily="{StaticResource DS.FontDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource DS.TextSoft}" VerticalAlignment="Center" /></Border><TextBlock x:Name="ScenarioHint" Text="All empty · no hardware access" FontSize="13" Foreground="#8695AC" VerticalAlignment="Center" Margin="0,0,16,0" /><TextBlock x:Name="MotionHint" Text="F8 Demo assignments" FontSize="13" Foreground="#6E7D94" VerticalAlignment="Center" /></StackPanel></Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
