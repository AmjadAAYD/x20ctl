<UserControl x:Class="X20Ctl.Product.ZoneScene" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:X20Ctl.Product" Loaded="OnLoaded" Unloaded="OnUnloaded" MouseMove="OnMouseMove" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{StaticResource Zone.TextPrimary}">
  <!-- the Controller Zone after the owner's mock (10 Oct 2026), kept navy: faceted glass backdrop, a quiet header,
       "Players" with an All players pill, the four controller cards, and the button hints along the bottom -->
  <Border x:Name="OuterFrame" CornerRadius="16" BorderBrush="{StaticResource Zone.BorderDefault}" BorderThickness="1" Background="{StaticResource Zone.Backdrop}">
    <Grid x:Name="Surface" ClipToBounds="True">
      <local:ZoneBackdrop x:Name="EnvironmentBackdrop" />
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
        <Border x:Name="HeaderBar" BorderBrush="Transparent" Background="Transparent" BorderThickness="0" Padding="24,0,16,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="BrandTile" Width="46" Height="46" CornerRadius="12" BorderBrush="{StaticResource Zone.BorderDefault}" BorderThickness="1" Background="{StaticResource Zone.ContentSurface}"><Image x:Name="BrandMark" Source="/X20Ctl;component/Assets/brand.png" Width="26" Height="26" /></Border>
              <TextBlock x:Name="BrandWord" Text="X20CTL" FontFamily="{StaticResource DS.FontDisplay}" FontSize="24" FontWeight="Bold" Margin="20,0,18,0" VerticalAlignment="Center" />
              <Border x:Name="BrandRule" Width="1" Height="22" Background="{StaticResource Zone.BorderDefault}" VerticalAlignment="Center" />
              <TextBlock x:Name="BrandLabel" Text="Controller Zone" FontFamily="{StaticResource DS.FontDisplay}" FontSize="17" Foreground="{StaticResource Zone.TextSecondary}" Margin="18,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ContentControl x:Name="UpdateNotice" Grid.Column="1" Margin="24,0" VerticalAlignment="Center" HorizontalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ToolsButton" Style="{StaticResource Zone.Secondary}" MinHeight="40" Height="40" Padding="18,0" FontSize="15" FontWeight="SemiBold" Margin="0,0,12,0" Click="Settings" ToolTip="Replay intro, Controller Check, About and more (Menu button)" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Tools">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,1,10,0" /><TextBlock Text="Tools" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="SupportButton" Click="Support" Style="{StaticResource Zone.Support}" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Support"/>
              <local:HeaderClock shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
              
              <Button Content="&#xE921;" Click="Minimize" Style="{StaticResource Zone.Icon}" KeyboardNavigation.TabIndex="20" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" />
              <Button x:Name="MaximizeButton" Content="&#xE922;" Click="Maximize" Style="{StaticResource Zone.Icon}" KeyboardNavigation.TabIndex="21" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fullscreen or window" />
              <Button Content="&#xE8BB;" Click="Close" Style="{StaticResource Zone.Icon}" KeyboardNavigation.TabIndex="22" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="Workspace" Grid.Row="1" Margin="56,34,56,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid x:Name="HeadingRow"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="Heading"><TextBlock Text="Player slots" Style="{StaticResource DS.Display}" FontWeight="Bold" FontSize="44" /><TextBlock Text="Choose a player to set up its controller" Style="{StaticResource DS.Body}" FontSize="17" Foreground="{StaticResource Zone.TextSecondary}" Margin="2,2,0,0" /></StackPanel>
            <Button x:Name="OverviewBack" Grid.Column="1" Style="{StaticResource Zone.Secondary}" MinHeight="46" Height="46" Padding="22,0" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" Click="BackToOverview" AutomationProperties.Name="Return to four-player overview">
              <StackPanel Orientation="Horizontal"><TextBlock x:Name="OverviewIcon" Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,1,12,0" /><TextBlock x:Name="OverviewLabel" Text="Selected player" VerticalAlignment="Center" /></StackPanel>
            </Button>
          </Grid>
          <Canvas x:Name="DockStage" Grid.Row="1" Margin="0,28,0,0" ClipToBounds="False" SizeChanged="OnStageSizeChanged">
            <Ellipse x:Name="FocusBloom" Visibility="Collapsed" Width="470" Height="340" Opacity="0" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#281A9FFF" Offset="0" /><GradientStop Color="#001A9FFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
          </Canvas>
          <!-- spoken status for screen readers; the cards themselves carry the state visually -->
          <TextBlock x:Name="FeedbackText" Grid.Row="1" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" Text="Select any player. All four docks begin equal." AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Border x:Name="FooterBar" Grid.Row="2" BorderBrush="{StaticResource Zone.BorderDefault}" Background="{StaticResource Zone.ChromeSurface}" BorderThickness="0,1,0,0" Padding="28,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NavigationHint" Text="" Visibility="Collapsed" /><StackPanel x:Name="ZoneHints" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Zone.StatusSurface}" Height="26" Padding="12,0" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock x:Name="ProvenanceText" Text="LIVE INPUT" FontFamily="{StaticResource DS.FontDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Zone.TextSecondary}" VerticalAlignment="Center" /></Border><TextBlock x:Name="ScenarioHint" Text="Waiting for controller input" FontSize="13" Foreground="{StaticResource Zone.TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0" /><TextBlock x:Name="MotionHint" Text="F8 Demo assignments" FontSize="13" Foreground="{StaticResource Zone.TextMuted}" VerticalAlignment="Center" /></StackPanel></Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
