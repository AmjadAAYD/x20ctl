<UserControl x:Class="X20Ctl.Product.DockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:X20Ctl.Product" UseLayoutRounding="True">
  <UserControl.RenderTransform><TransformGroup><ScaleTransform x:Name="PlacementScale" ScaleX="1" ScaleY="1" /><TranslateTransform x:Name="PlacementOffset" /></TransformGroup></UserControl.RenderTransform>
  <Grid RenderTransformOrigin=".5,.5" ClipToBounds="True">
    <Grid.RenderTransform><ScaleTransform x:Name="LiftScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
    <!-- a controller card in Steam's restraint: navy-grey glass, one blue accent for the chosen controller, a white edge
         for focus; the whole card is the focus/click target -->
    <Border x:Name="Card" CornerRadius="16" BorderThickness="1" Margin="6" IsHitTestVisible="False" Background="{StaticResource Zone.ContentSurface}" BorderBrush="{StaticResource Zone.BorderDefault}" />
    <Path x:Name="Stripes" Visibility="Collapsed" />
    <Button x:Name="FocusButton" Background="Transparent" Padding="0" Click="SelectPlayer" FocusVisualStyle="{x:Null}" Cursor="Hand">
      <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate></Button.Template>
    </Button>
    <Canvas x:Name="ContentCanvas">
      <Border IsHitTestVisible="False" x:Name="PlayerPill" CornerRadius="13" Height="34" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"><TextBlock x:Name="PlayerLabel" FontFamily="{StaticResource DS.FontDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Zone.TextPrimary}" VerticalAlignment="Center" /></Border>
      <Ellipse x:Name="Halo" Visibility="Collapsed" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1CB8CCEA" Offset="0" /><GradientStop Color="#0AB8CCEA" Offset=".55" /><GradientStop Color="#00B8CCEA" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Ellipse x:Name="ArtShadow" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8C000000" Offset="0" /><GradientStop Color="#00000000" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Grid x:Name="Art" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="ArtScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
        <Viewbox IsHitTestVisible="False" x:Name="Illustration" Stretch="Uniform" Visibility="Collapsed"><Grid x:Name="ImageClip" Width="1536" Height="1024"><Image x:Name="ControllerImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Fill" /><local:ControllerOutline x:Name="ArtOutline" Visibility="Collapsed" /></Grid></Viewbox>
        <Grid x:Name="Silhouette"><Viewbox Stretch="Uniform" Margin="2" IsHitTestVisible="False"><Canvas Width="537.5" Height="358.4"><Path x:Name="SilhouettePath" Canvas.Left="26" Canvas.Top="26" Stroke="{StaticResource Zone.TextSecondary}" StrokeThickness="4.5" StrokeLineJoin="Round"><Path.Fill><StaticResource ResourceKey="Zone.PlaceholderFill" /></Path.Fill></Path></Canvas></Viewbox><Border x:Name="PlusBadge" Width="72" Height="84" Background="Transparent" CornerRadius="20" Cursor="Hand" RenderTransformOrigin=".5,.5" ToolTip="Choose a controller for this player" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2"><Ellipse Width="9" Height="9" Margin="5,0" Fill="{StaticResource Zone.TextSecondary}"></Ellipse><Ellipse Width="9" Height="9" Margin="5,0" Fill="{StaticResource Zone.TextSecondary}"></Ellipse><Ellipse Width="9" Height="9" Margin="5,0" Fill="{StaticResource Zone.TextSecondary}"></Ellipse></StackPanel><TextBlock Text="+" FontFamily="{StaticResource DS.FontDisplay}" FontSize="42" FontWeight="SemiBold" Foreground="{StaticResource Zone.TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0"></TextBlock></StackPanel></Border></Grid>
      </Grid>
      <Canvas x:Name="Details" IsHitTestVisible="False">
        <TextBlock x:Name="ModelName" FontFamily="{StaticResource DS.FontDisplay}" FontWeight="SemiBold" Foreground="{StaticResource Zone.TextPrimary}" />
        <Border x:Name="ConnectionBadge" CornerRadius="12" Padding="9,4" Background="#20D9B675"><StackPanel x:Name="StatusLine" Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="1,0,8,0" VerticalAlignment="Center" /><TextBlock x:Name="Connection" FontFamily="{StaticResource DS.FontBody}" FontSize="13" Foreground="{StaticResource Zone.SemanticWarning}" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Border>
      </Canvas>
      <!-- the arrow: this card leads somewhere -->
      <Border x:Name="ArrowBadge" Width="40" Height="40" Style="{StaticResource Zone.StatusSurface}"><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Zone.TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
    </Canvas>
    <Canvas x:Name="ActionCanvas" Visibility="Collapsed">
      <Button x:Name="Primary" Style="{StaticResource PrimaryButton}" Height="38" Click="PrimaryAction" />
      <Button x:Name="Switch" Content="Switch Controller" Style="{StaticResource ActionButton}" Height="38" Width="156" Click="SwitchAction" />
    </Canvas>
    <Button x:Name="AddControllerButton" Content="+ Add controller" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" Width="146" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0" Click="AddController" ToolTip="Choose a controller for this player slot"/>
    <Button x:Name="RemoveControllerButton" Content="Remove" Style="{StaticResource ActionButton}" FontSize="14" Width="78" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0" Visibility="Collapsed" Click="RemoveController" ToolTip="Remove controller from this player slot" AutomationProperties.Name="Remove controller from player slot"/>
  </Grid>
</UserControl>
