<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:X20Ctl.Product">
  <!-- Controller Zone: environment, chrome, content, state, then accent. -->
  <SolidColorBrush x:Key="Zone.Backdrop" Color="#080E22" />
  <SolidColorBrush x:Key="Zone.ChromeSurface" Color="#160E1834" />
  <LinearGradientBrush x:Key="Zone.ContentSurface" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#182445" Offset="0"/><GradientStop Color="#121C35" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Zone.ContentSurfaceHover" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#20325A" Offset="0"/><GradientStop Color="#192846" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Zone.ContentSurfaceSelected" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#23365C" Offset="0"/><GradientStop Color="#192A49" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Zone.BorderDefault" Color="#26375A" />
  <SolidColorBrush x:Key="Zone.BorderHover" Color="#5978AC" />
  <SolidColorBrush x:Key="Zone.BorderSelected" Color="#8AB9FF" />
  <SolidColorBrush x:Key="Zone.TextPrimary" Color="#EDF2F8" />
  <SolidColorBrush x:Key="Zone.TextSecondary" Color="#A9B6C8" />
  <SolidColorBrush x:Key="Zone.TextMuted" Color="#92A0B2" />
  <SolidColorBrush x:Key="Zone.AccentPrimary" Color="#5B9FE7" />
  <SolidColorBrush x:Key="Zone.AccentFill" Color="#326EAE" />
  <SolidColorBrush x:Key="Zone.SemanticSuccess" Color="#78C39D" />
  <SolidColorBrush x:Key="Zone.SemanticWarning" Color="#D9B675" />
  <SolidColorBrush x:Key="Zone.SemanticError" Color="#D78286" />
  <SolidColorBrush x:Key="Zone.PlaceholderFill" Color="#121E3A" />
  <Style x:Key="Zone.ButtonBase" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <SolidColorBrush x:Key="Zone.GlassFill" Color="#1C2B46"/>
  <!-- Legacy aliases kept for external templates; new call sites use semantic names. -->
  <Style x:Key="Zone.Glass" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <Style x:Key="Zone.Secondary" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <Style x:Key="Zone.Primary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
  <Style x:Key="Zone.Utility" TargetType="Button" BasedOn="{StaticResource Zone.ButtonBase}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}"/></ContentPresenter.Resources></ContentPresenter></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#10FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A0B5D9FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Zone.Icon" TargetType="Button" BasedOn="{StaticResource Zone.Utility}"><Setter Property="Width" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}"/></ContentPresenter.Resources></ContentPresenter></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#16FFFFFF"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="Content" Value="&#xE8BB;"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="#CCCF3E52"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Zone.Status" TargetType="Button" BasedOn="{StaticResource Zone.Secondary}"><Setter Property="Foreground" Value="{StaticResource Zone.TextSecondary}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Zone.StatusSurface" TargetType="Border"><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{StaticResource Zone.ChromeSurface}"/><Setter Property="BorderBrush" Value="{StaticResource Zone.BorderDefault}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <SolidColorBrush x:Key="Zone.SupportFill" Color="#91334C"/>
  <Style x:Key="Zone.Support" TargetType="Button" BasedOn="{StaticResource Zone.ButtonBase}"><Setter Property="Width" Value="166"/><Setter Property="Height" Value="42"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Grid><local:CyclingSupportOutline x:Name="SupportOutline"><Border x:Name="Face" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}" BorderBrush="#FFB29B" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,.2"><GradientStop Color="#F33B67" Offset="0"/><GradientStop Color="#F1653D" Offset=".7"/><GradientStop Color="#FA843D" Offset="1"/></LinearGradientBrush></Border.Background>
<Grid Margin="4,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Width="28" Height="28"><TextBlock Text="♥" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" Foreground="#EF4367" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border><TextBlock Grid.Column="1" Text="Support" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/><Border Grid.Column="2" Height="22" CornerRadius="11" BorderBrush="#D9FFE6D5" BorderThickness="1" Background="#14FFFFFF"><TextBlock Text="≡" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border></Grid>
</Border></local:CyclingSupportOutline></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
