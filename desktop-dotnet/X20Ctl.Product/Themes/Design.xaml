<!--
  X20CTL design system. One source for colour, glass, type, radii, motion and the shared controls.
  Keys are prefixed "DS." so they never collide with the older Console* styles while pages migrate.
  Direction: dark space glass (ApexSenseBridge discipline, concept-art glow) at Steam Big Picture scale.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local="clr-namespace:X20Ctl.Product">

  <!-- ===== Colour tokens ===== -->
  <Color x:Key="DS.C.Void">#04070F</Color>
  <Color x:Key="DS.C.Deep">#070C1B</Color>
  <Color x:Key="DS.C.Night">#0B1430</Color>
  <Color x:Key="DS.C.Accent">#3D8BFF</Color>
  <Color x:Key="DS.C.AccentHi">#7DB6FF</Color>
  <Color x:Key="DS.C.AccentGlow">#2F7BFF</Color>
  <Color x:Key="DS.C.Success">#34D399</Color>
  <Color x:Key="DS.C.Warn">#F5B45B</Color>
  <Color x:Key="DS.C.Danger">#FF5C7A</Color>
  <Color x:Key="DS.C.Violet">#9B7BFF</Color>

  <SolidColorBrush x:Key="DS.Void" Color="{StaticResource DS.C.Void}" />
  <SolidColorBrush x:Key="DS.Deep" Color="{StaticResource DS.C.Deep}" />
  <SolidColorBrush x:Key="DS.Accent" Color="{StaticResource DS.C.Accent}" />
  <SolidColorBrush x:Key="DS.AccentHi" Color="{StaticResource DS.C.AccentHi}" />
  <SolidColorBrush x:Key="DS.Success" Color="{StaticResource DS.C.Success}" />
  <SolidColorBrush x:Key="DS.Warn" Color="{StaticResource DS.C.Warn}" />
  <SolidColorBrush x:Key="DS.Danger" Color="{StaticResource DS.C.Danger}" />
  <SolidColorBrush x:Key="DS.Text" Color="#F4F7FD" />
  <SolidColorBrush x:Key="DS.TextSoft" Color="#B4C0D8" />
  <SolidColorBrush x:Key="DS.TextMuted" Color="#76839F" />
  <SolidColorBrush x:Key="DS.TextOnLight" Color="#0A1226" />

  <!-- Glass: translucent navy with a faint top highlight; borders are light, never heavy outlines -->
  <LinearGradientBrush x:Key="DS.Glass" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C0121C3A" Offset="0" /><GradientStop Color="#B00C1430" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DS.GlassRaised" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D81A2750" Offset="0" /><GradientStop Color="#C8111B3C" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="DS.GlassSubtle" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="DS.GlassHover" Color="#22FFFFFF" />
  <LinearGradientBrush x:Key="DS.GlassBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#40AFC8FF" Offset="0" /><GradientStop Color="#12AFC8FF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="DS.Hairline" Color="#1CFFFFFF" />
  <SolidColorBrush x:Key="DS.Track" Color="#2A3656" />
  <LinearGradientBrush x:Key="DS.AccentFill" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#2F7BFF" Offset="0" /><GradientStop Color="#5AA2FF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="DS.Scrim" Color="#A8030611" />

  <!-- ===== Type ===== -->
  <FontFamily x:Key="DS.FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="DS.FontBody">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DS.FontMono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="DS.Size.Display">44</sys:Double>
  <sys:Double x:Key="DS.Size.Title">30</sys:Double>
  <sys:Double x:Key="DS.Size.Heading">21</sys:Double>
  <sys:Double x:Key="DS.Size.Body">16</sys:Double>
  <sys:Double x:Key="DS.Size.Caption">13.5</sys:Double>

  <Style x:Key="DS.Display" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="{StaticResource DS.Size.Display}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource DS.Text}" /><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /></Style>
  <Style x:Key="DS.Title" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="{StaticResource DS.Size.Title}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource DS.Text}" /></Style>
  <Style x:Key="DS.Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="{StaticResource DS.Size.Heading}" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{StaticResource DS.Text}" /></Style>
  <Style x:Key="DS.Body" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DS.FontBody}" /><Setter Property="FontSize" Value="{StaticResource DS.Size.Body}" /><Setter Property="Foreground" Value="{StaticResource DS.TextSoft}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="24" /></Style>
  <Style x:Key="DS.Caption" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DS.FontBody}" /><Setter Property="FontSize" Value="{StaticResource DS.Size.Caption}" /><Setter Property="Foreground" Value="{StaticResource DS.TextMuted}" /></Style>
  <Style x:Key="DS.Eyebrow" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource DS.AccentHi}" /><Setter Property="Typography.Capitals" Value="AllSmallCaps" /></Style>
  <Style x:Key="DS.Metric" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="34" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{StaticResource DS.Text}" /></Style>

  <!-- ===== Radii / spacing / motion ===== -->
  <CornerRadius x:Key="DS.R.Surface">22</CornerRadius>
  <CornerRadius x:Key="DS.R.Card">16</CornerRadius>
  <CornerRadius x:Key="DS.R.Control">12</CornerRadius>
  <CornerRadius x:Key="DS.R.Pill">10</CornerRadius>
  <local:HalfHeightRadius x:Key="DS.HalfHeight" />
  <Thickness x:Key="DS.Pad.Surface">28,24,28,24</Thickness>
  <Thickness x:Key="DS.Pad.Card">20,16,20,16</Thickness>
  <Duration x:Key="DS.T.Fast">0:0:0.14</Duration>
  <Duration x:Key="DS.T.Base">0:0:0.22</Duration>
  <Duration x:Key="DS.T.Slow">0:0:0.38</Duration>
  <CubicEase x:Key="DS.EaseOut" EasingMode="EaseOut" />
  <QuinticEase x:Key="DS.EaseOutStrong" EasingMode="EaseOut" />

  <!-- ===== Effects ===== -->
  <DropShadowEffect x:Key="DS.Shadow.Surface" Color="#000000" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity=".55" RenderingBias="Performance" />
  <DropShadowEffect x:Key="DS.Glow.Accent" Color="{StaticResource DS.C.AccentGlow}" BlurRadius="26" ShadowDepth="0" Opacity=".75" RenderingBias="Performance" />
  <DropShadowEffect x:Key="DS.Glow.Success" Color="{StaticResource DS.C.Success}" BlurRadius="16" ShadowDepth="0" Opacity=".55" RenderingBias="Performance" />

  <!-- ===== Surfaces ===== -->
  <Style x:Key="DS.Surface" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DS.Glass}" /><Setter Property="BorderBrush" Value="{StaticResource DS.GlassBorder}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DS.R.Surface}" /><Setter Property="Padding" Value="{StaticResource DS.Pad.Surface}" />
  </Style>
  <Style x:Key="DS.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DS.GlassSubtle}" /><Setter Property="BorderBrush" Value="{StaticResource DS.Hairline}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DS.R.Card}" /><Setter Property="Padding" Value="{StaticResource DS.Pad.Card}" />
  </Style>

  <!-- Text inside templates inherits the control's font and colour (the app-wide TextBlock style would otherwise win) -->
  <Style x:Key="DS.InheritText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Control}}" />
  </Style>

  <!-- ===== Focus: no dotted Windows rectangle; focus is drawn by the app's moving focus ring ===== -->
  <Style x:Key="DS.NoFocusVisual"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle /></ControlTemplate></Setter.Value></Setter></Style>


  <!-- Navy and cobalt retain the reference capsule proportions, with depth and visible interaction states. -->
  <LinearGradientBrush x:Key="Control.ButtonFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#30384C" Offset="0"/><GradientStop Color="#272E40" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Control.PrimaryFill" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4598F5" Offset="0"/><GradientStop Color="#287CE9" Offset="1"/></LinearGradientBrush>
  <Style x:Key="ActionButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource DS.Text}"/>
    <Setter Property="Background" Value="{StaticResource Control.ButtonFill}"/><Setter Property="BorderBrush" Value="#434C63"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22,0"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
      <Border x:Name="Face" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid>
          <Border x:Name="Rim" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}" BorderThickness=".7" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#42D9EAFF" Offset="0"/><GradientStop Color="#06D9EAFF" Offset=".65"/><GradientStop Color="#19060C1B" Offset="1"/></LinearGradientBrush></Border.BorderBrush></Border>
          <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}" Background="#81BDFF" Opacity="0" IsHitTestVisible="False"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}"/></ContentPresenter.Resources></ContentPresenter>
        </Grid>
      </Border></Grid>
      <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To=".18" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#B5DBFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="#08152D"/><Setter TargetName="Face" Property="Opacity" Value=".9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Background" Value="{StaticResource Control.PrimaryFill}"/><Setter Property="BorderBrush" Value="#78B7FF"/></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Width" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style x:Key="GamepadKeycap" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Background" Value="#111D31"/><Setter Property="BorderBrush" Value="#43516A"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="6,0"/></Style>
  <Style x:Key="SegmentOption" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,0"/></Style>
  <Style x:Key="StatusTag" TargetType="Border"><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="#19263E"/><Setter Property="Padding" Value="8,4"/></Style>
  <Style x:Key="SegmentedControl" TargetType="Border"><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="3"/><Setter Property="Background" Value="#101B30"/><Setter Property="BorderBrush" Value="#2B3D5A"/><Setter Property="BorderThickness" Value="1"/></Style>

  <!-- ===== Buttons ===== -->
  <Style x:Key="DS.ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource DS.Text}" /><Setter Property="Padding" Value="30,0" /><Setter Property="MinHeight" Value="54" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource DS.NoFocusVisual}" /><Setter Property="RenderTransformOrigin" Value=".5,.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
  </Style>
  <Style x:Key="DS.Primary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
  <Style x:Key="DS.Secondary" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <Style x:Key="DS.Icon" TargetType="Button" BasedOn="{StaticResource DS.Secondary}">
    <Setter Property="Width" Value="46" /><Setter Property="Height" Value="46" /><Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" /><Setter Property="FontSize" Value="16" />
  </Style>

  <!-- ===== Pills (segmented choices, as in the scanner concepts) ===== -->
  <Style x:Key="DS.Pill" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource DS.TextSoft}" />
    <Setter Property="Padding" Value="24,0" /><Setter Property="Height" Value="48" /><Setter Property="Margin" Value="0,0,10,10" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DS.NoFocusVisual}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Body" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}" Background="{StaticResource DS.GlassSubtle}" BorderBrush="{StaticResource DS.Hairline}" BorderThickness="1" Padding="{TemplateBinding Padding}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid x:Name="Dot" Width="16" Height="16" Margin="0,0,10,0" Visibility="Collapsed"><Ellipse Stroke="{StaticResource DS.Accent}" StrokeThickness="2" /><Ellipse Width="7" Height="7" Fill="{StaticResource DS.Accent}" /></Grid>
          <ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}" /></ContentPresenter.Resources></ContentPresenter>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{StaticResource DS.GlassHover}" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="#F4F7FD" /><Setter TargetName="Body" Property="BorderBrush" Value="White" /><Setter Property="Foreground" Value="{StaticResource DS.TextOnLight}" /><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource DS.AccentHi}" /><Setter TargetName="Body" Property="BorderThickness" Value="2" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>


  <!-- ===== Toggle switch (animated thumb) ===== -->
  <Style x:Key="DS.Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource DS.NoFocusVisual}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Width="52" Height="30" Background="Transparent">
        <Border x:Name="Track" CornerRadius="15" Background="{StaticResource DS.Track}" BorderBrush="#26FFFFFF" BorderThickness="1" />
        <Border x:Name="Fill" CornerRadius="15" Background="{StaticResource DS.AccentFill}" Opacity="0" />
        <Ellipse x:Name="Thumb" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
          <Ellipse.RenderTransform><TranslateTransform x:Name="Slide" /></Ellipse.RenderTransform>
          <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity=".4" /></Ellipse.Effect>
        </Ellipse>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="22" Duration="{StaticResource DS.T.Base}" EasingFunction="{StaticResource DS.EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DS.T.Base}" />
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource DS.T.Base}" EasingFunction="{StaticResource DS.EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DS.T.Base}" />
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Slider (luminous fill + white thumb) ===== -->
  <Style x:Key="DS.SliderThumb" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Ellipse Width="22" Height="22" Fill="White"><Ellipse.Effect><DropShadowEffect Color="{StaticResource DS.C.AccentGlow}" BlurRadius="14" ShadowDepth="0" Opacity=".9" /></Ellipse.Effect></Ellipse>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DS.SliderRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DS.Slider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource DS.NoFocusVisual}" /><Setter Property="Height" Value="30" /><Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid VerticalAlignment="Center">
        <Border x:Name="TrackBg" Height="6" CornerRadius="3" Background="{StaticResource DS.Track}" />
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource DS.SliderRepeat}" Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{StaticResource DS.AccentFill}" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource DS.SliderRepeat}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource DS.SliderThumb}" /></Track.Thumb>
        </Track>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TrackBg" Property="Background" Value="#3C4C78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Tabs (text tabs with a short glowing underline) ===== -->
  <Style x:Key="DS.Tab" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="#B8C4DC" />
    <Setter Property="Margin" Value="0,0,30,0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource DS.NoFocusVisual}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid Background="Transparent">
        <ContentPresenter Margin="0,10,0,14" HorizontalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}" /></ContentPresenter.Resources></ContentPresenter>
        <Border x:Name="Underline" Height="3" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}" VerticalAlignment="Bottom" Background="{StaticResource DS.AccentHi}" Opacity="0" Effect="{StaticResource DS.Glow.Accent}" RenderTransformOrigin=".5,.5">
          <Border.RenderTransform><ScaleTransform x:Name="UnderlineScale" ScaleX=".2" /></Border.RenderTransform>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource DS.TextSoft}" /></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{StaticResource DS.Text}" />
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DS.T.Base}" />
            <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource DS.T.Slow}" EasingFunction="{StaticResource DS.EaseOutStrong}" />
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DS.T.Fast}" />
            <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To=".2" Duration="{StaticResource DS.T.Fast}" />
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="White" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Mock-faithful action row: tall rounded primary, outlined secondary, round "…" ===== -->
  <Style x:Key="DS.ActionPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
  <Style x:Key="DS.ActionSecondary" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <Style x:Key="DS.ActionRound" TargetType="Button" BasedOn="{StaticResource DS.ActionSecondary}">
    <Setter Property="Width" Value="48" /><Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" /><Setter Property="FontSize" Value="18" />
  </Style>

  <!-- ===== Apple-style segmented control: one track, a raised white segment for the selection ===== -->
  <Style x:Key="DS.Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource DS.FontDisplay}" /><Setter Property="FontSize" Value="14.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#C3CDE2" />
    <Setter Property="Height" Value="36" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource DS.NoFocusVisual}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid><Border Background="{StaticResource Control.ButtonFill}" CornerRadius="18" Margin="2"/>
        <Border x:Name="Thumb" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource DS.HalfHeight}}" Margin="3" Background="#F5F6FA" Opacity="0"></Border>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}" /></ContentPresenter.Resources></ContentPresenter>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Thumb" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="#111827" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Thumb" Property="Opacity" Value=".22" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="IsChecked" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Thumb" Property="Opacity" Value="1" /></MultiTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ===== Red Support pill (title bars) ===== -->
  <Style x:Key="DS.SupportPill" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>

  <!-- ===== Settings row (icon · label/detail · trailing control) ===== -->
  <Style x:Key="DS.Row" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DS.GlassSubtle}" /><Setter Property="CornerRadius" Value="{StaticResource DS.R.Control}" /><Setter Property="Padding" Value="18,12" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="MinHeight" Value="58" />
  </Style>
  <!-- ===== Popups: menus, tooltips, scroll bars and text fields. Implicit, so every page gets the navy glass
       look and nothing falls back to the white Windows defaults. ===== -->
  <SolidColorBrush x:Key="DS.PopupFill" Color="#F4101A33" />
  <SolidColorBrush x:Key="DS.PopupBorder" Color="#3A8FB4E8" />
  <DropShadowEffect x:Key="DS.Shadow.Popup" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity=".55" Color="#000000" />
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource DS.Text}" /><Setter Property="FontFamily" Value="{StaticResource DS.FontBody}" /><Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="{StaticResource DS.PopupFill}" /><Setter Property="BorderBrush" Value="{StaticResource DS.PopupBorder}" />
    <Setter Property="Padding" Value="6" /><Setter Property="HasDropShadow" Value="False" /><Setter Property="MinWidth" Value="220" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Margin="8,4,8,12" Effect="{StaticResource DS.Shadow.Popup}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource DS.Text}" /><Setter Property="FontSize" Value="15" /><Setter Property="Padding" Value="14,10" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="MinHeight" Value="42" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ContentPresenter x:Name="Glyph" ContentSource="Icon" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" />
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" Foreground="{StaticResource DS.TextMuted}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A3D8BFF" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A3D8BFF" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,5" Background="{StaticResource DS.Hairline}" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource DS.Text}" /><Setter Property="FontFamily" Value="{StaticResource DS.FontBody}" /><Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{StaticResource DS.PopupFill}" /><Setter Property="BorderBrush" Value="{StaticResource DS.PopupBorder}" /><Setter Property="Padding" Value="12,8" />
    <Setter Property="HasDropShadow" Value="False" /><Setter Property="Placement" Value="Bottom" /><Setter Property="VerticalOffset" Value="6" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Margin="8,2,8,12" MaxWidth="380" Effect="{StaticResource DS.Shadow.Popup}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
        <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="20" /></Style></ContentPresenter.Resources></ContentPresenter>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource DS.Text}" /><Setter Property="Padding" Value="14,9" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="4,2" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A3D8BFF" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#263D8BFF" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Both orientations: the older Controls.xaml template was vertical-only, which broke the macro timeline's bar. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Width" Value="10" /><Setter Property="MinWidth" Value="0" /><Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent"><Border CornerRadius="4" Background="#12FFFFFF" Margin="2" />
        <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="T" CornerRadius="3" Background="#707C97BE" Margin="2" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#A0A8C4EA" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#7DB6FF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="10" /><Setter Property="MinHeight" Value="0" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource DS.Text}" /><Setter Property="Background" Value="#1AFFFFFF" /><Setter Property="BorderBrush" Value="{StaticResource DS.Hairline}" />
    <Setter Property="CaretBrush" Value="{StaticResource DS.AccentHi}" /><Setter Property="SelectionBrush" Value="{StaticResource DS.Accent}" /><Setter Property="SelectionOpacity" Value=".45" />
    <Setter Property="FontSize" Value="16" /><Setter Property="Padding" Value="10,6" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ContextMenu"><Setter.Value><ContextMenu><MenuItem Command="ApplicationCommands.Cut" Header="Cut" InputGestureText="Ctrl+X" /><MenuItem Command="ApplicationCommands.Copy" Header="Copy" InputGestureText="Ctrl+C" /><MenuItem Command="ApplicationCommands.Paste" Header="Paste" InputGestureText="Ctrl+V" /></ContextMenu></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#5A8FB4E8" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DS.AccentHi}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DS.TopTab" TargetType="RadioButton"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#A6B3CB"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border Background="Transparent" Padding="14,8"><ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}"/></ContentPresenter.Resources></ContentPresenter></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<LinearGradientBrush x:Key="Bumper.NavyGloss" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#263F60" Offset="0"/><GradientStop Color="#192F4D" Offset=".22"/><GradientStop Color="#10253F" Offset=".5"/><GradientStop Color="#09192D" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="Bumper.NavyHover" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#355777" Offset="0"/><GradientStop Color="#203C5A" Offset=".45"/><GradientStop Color="#122B43" Offset="1"/></LinearGradientBrush>
<!-- LB / RB as shoulder buttons (owner request 17 Oct 2026: controller-ish, sleek and modern): a keycap that wraps round
     the controller's corner on its outer end, lit from above, a fine highlight along the top, a chevron for direction,
     and the accent edge and glow on hover -->
<LinearGradientBrush x:Key="Bumper.Body" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2E4A6E" Offset="0"/><GradientStop Color="#1A2E4B" Offset=".45"/><GradientStop Color="#0D1A2D" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="Bumper.BodyHover" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A5D88" Offset="0"/><GradientStop Color="#213B5E" Offset=".45"/><GradientStop Color="#112239" Offset="1"/></LinearGradientBrush>
<DropShadowEffect x:Key="Bumper.Glow" Color="#3D8BFF" BlurRadius="12" ShadowDepth="0" Opacity=".55"/>
<DropShadowEffect x:Key="Bumper.GlowPressed" Color="#3D8BFF" BlurRadius="12" ShadowDepth="0" Opacity=".8"/>
<TranslateTransform x:Key="Bumper.PressShift" Y="1.5"/>
<Style x:Key="BumperLeft" TargetType="Button" BasedOn="{StaticResource GamepadKeycap}"><Setter Property="Width" Value="66"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="Root" ToolTip="{TemplateBinding ToolTip}" Background="Transparent" RenderTransformOrigin=".5,.5">
<Path x:Name="Bumper" Data="M 16,1.5 L 59,1.5 C 62.6,1.5 64.5,3.4 64.5,7 L 64.5,23 C 64.5,26.6 62.6,28.5 59,28.5 L 22,28.5 C 13,28.5 5.5,23.5 2.5,15.5 C 0.8,10.8 4.5,1.5 16,1.5 Z" Fill="{StaticResource Bumper.Body}" Stroke="#4C6A91" StrokeThickness=".9" StrokeLineJoin="Round" RenderTransformOrigin=".5,.5"><Path.RenderTransform><ScaleTransform ScaleX="1"/></Path.RenderTransform></Path>
<Path Data="M 4.5,12 C 6.5,5.5 10.5,2.6 16,2.6 L 59,2.6 C 61.2,2.6 62.6,3.4 63.2,5.2" Stroke="#C9DBF2" StrokeThickness=".8" Opacity=".55" IsHitTestVisible="False" RenderTransformOrigin=".5,.5"><Path.RenderTransform><ScaleTransform ScaleX="1"/></Path.RenderTransform></Path>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False"><TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8.5" Foreground="#8FA9CB" VerticalAlignment="Center" Margin="0,1,5,0"/><ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#EAF0FA"/></Style></ContentPresenter.Resources></ContentPresenter></StackPanel>
</Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bumper" Property="Fill" Value="{StaticResource Bumper.BodyHover}"/><Setter TargetName="Bumper" Property="Stroke" Value="#7DB6FF"/><Setter TargetName="Bumper" Property="Effect" Value="{StaticResource Bumper.Glow}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bumper" Property="Stroke" Value="White"/><Setter TargetName="Bumper" Property="StrokeThickness" Value="1.4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bumper" Property="Fill" Value="#0E1D33"/><Setter TargetName="Root" Property="RenderTransform" Value="{StaticResource Bumper.PressShift}"/><Setter TargetName="Bumper" Property="Effect" Value="{StaticResource Bumper.GlowPressed}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="BumperRight" TargetType="Button" BasedOn="{StaticResource GamepadKeycap}"><Setter Property="Width" Value="66"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="Root" ToolTip="{TemplateBinding ToolTip}" Background="Transparent" RenderTransformOrigin=".5,.5">
<Path x:Name="Bumper" Data="M 16,1.5 L 59,1.5 C 62.6,1.5 64.5,3.4 64.5,7 L 64.5,23 C 64.5,26.6 62.6,28.5 59,28.5 L 22,28.5 C 13,28.5 5.5,23.5 2.5,15.5 C 0.8,10.8 4.5,1.5 16,1.5 Z" Fill="{StaticResource Bumper.Body}" Stroke="#4C6A91" StrokeThickness=".9" StrokeLineJoin="Round" RenderTransformOrigin=".5,.5"><Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform></Path>
<Path Data="M 4.5,12 C 6.5,5.5 10.5,2.6 16,2.6 L 59,2.6 C 61.2,2.6 62.6,3.4 63.2,5.2" Stroke="#C9DBF2" StrokeThickness=".8" Opacity=".55" IsHitTestVisible="False" RenderTransformOrigin=".5,.5"><Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform></Path>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False"><ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource DS.InheritText}"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#EAF0FA"/></Style></ContentPresenter.Resources></ContentPresenter><TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8.5" Foreground="#8FA9CB" VerticalAlignment="Center" Margin="5,1,0,0"/></StackPanel>
</Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bumper" Property="Fill" Value="{StaticResource Bumper.BodyHover}"/><Setter TargetName="Bumper" Property="Stroke" Value="#7DB6FF"/><Setter TargetName="Bumper" Property="Effect" Value="{StaticResource Bumper.Glow}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bumper" Property="Stroke" Value="White"/><Setter TargetName="Bumper" Property="StrokeThickness" Value="1.4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bumper" Property="Fill" Value="#0E1D33"/><Setter TargetName="Root" Property="RenderTransform" Value="{StaticResource Bumper.PressShift}"/><Setter TargetName="Bumper" Property="Effect" Value="{StaticResource Bumper.GlowPressed}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
