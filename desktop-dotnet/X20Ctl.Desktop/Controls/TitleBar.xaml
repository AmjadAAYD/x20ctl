<UserControl x:Class="X20Ctl.Desktop.Controls.TitleBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Name="Root">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="27,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/brand-mark.png" Width="24" Height="24" Margin="0,0,10,0" /><TextBlock Text="X20CTL" FontSize="19" FontWeight="Bold" /><Border Width="1" Height="19" Background="{StaticResource Line}" Margin="19,0,19,0" /><TextBlock Text="{Binding Caption, ElementName=Root}" FontSize="13" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ScannerLink" Content="Scanner ↗" Click="OpenScanner" Style="{StaticResource QuietButton}" Margin="0,0,13,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Open native scanner preview" /><Button Content="—" Click="Minimize" Style="{StaticResource ChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" /><Button Content="□" Click="MaximizeRestore" Style="{StaticResource ChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize or restore" /><Button Content="×" Click="CloseWindow" Style="{StaticResource ChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" /></StackPanel>
    </Grid></Border>
</UserControl>
