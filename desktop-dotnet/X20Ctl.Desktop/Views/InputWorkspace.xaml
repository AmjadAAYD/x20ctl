<UserControl x:Class="X20Ctl.Desktop.Views.InputWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:X20Ctl.Desktop.Controls" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="OverviewGroup" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSegment}" Value="Inputs"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding SelectedSegment}" Value="Buttons"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SticksGroup" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedSegment}" Value="Inputs" /><Condition Binding="{Binding IsCompact}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger><DataTrigger Binding="{Binding SelectedSegment}" Value="Sticks"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="TriggersGroup" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSegment}" Value="Inputs"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding SelectedSegment}" Value="Triggers"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SignalGroup" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSegment}" Value="Signal"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>
    <Grid Margin="30,18,30,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding SectionLabel}" Style="{StaticResource Eyebrow}" Margin="0,0,0,5" /><TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryCopy}" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="1" Background="#22D59D49" CornerRadius="7" Padding="11,7" VerticalAlignment="Top" Margin="16,7,0,0"><TextBlock Text="DEVELOPMENT SIMULATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Amber}" /></Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" MinWidth="328" /></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="3,6,3,0"><TextBlock Text="EasySMX X20" FontSize="19" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="6" Height="6" Fill="{Binding ConnectionColor}" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionColor}" FontSize="10" VerticalAlignment="Center" /></StackPanel></DockPanel>
                <controls:ControllerVisualizer x:Name="ControllerArt" Grid.Row="1" Frame="{Binding Frame}" Margin="-14,4,-14,0" />
                <StackPanel Grid.Row="2">
                    <Grid Margin="4,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="INPUT SOURCE" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding SourceLabel}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="SAMPLE CLOCK" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Mono}" Margin="0,6,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0"><TextBlock Text="EVIDENCE" Style="{StaticResource Eyebrow}" /><TextBlock Text="Simulation only" Foreground="{StaticResource Amber}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" CornerRadius="18" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="21,17">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel x:Name="InspectorTabs" Margin="-8,0,-8,15">
                        <RadioButton x:Name="InputsTab" Content="Inputs" Tag="Inputs" IsChecked="True" GroupName="Inspector" Style="{StaticResource Segment}" Checked="SegmentChecked" />
                        <RadioButton Content="Sticks" Tag="Sticks" GroupName="Inspector" Style="{StaticResource Segment}" Checked="SegmentChecked" />
                        <RadioButton Content="Buttons" Tag="Buttons" GroupName="Inspector" Style="{StaticResource Segment}" Checked="SegmentChecked" />
                        <RadioButton Content="Triggers" Tag="Triggers" GroupName="Inspector" Style="{StaticResource Segment}" Checked="SegmentChecked" />
                        <RadioButton Content="Signal" Tag="Signal" GroupName="Inspector" Style="{StaticResource Segment}" Checked="SegmentChecked" />
                    </WrapPanel>
                    <ScrollViewer x:Name="InspectorContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" Focusable="False">
                        <StackPanel>
                            <StackPanel x:Name="HoldPanel" Style="{StaticResource OverviewGroup}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="CURRENT INPUT" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding PressedControl}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding HeldDuration}" FontSize="38" FontWeight="Light" /><TextBlock Text="s" Foreground="{StaticResource MutedText}" FontSize="16" VerticalAlignment="Bottom" Margin="6,0,0,6" /></StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding LastRelease}" FontSize="12" Foreground="{StaticResource Success}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ButtonNames}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,5,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSegment}" Value="Buttons"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10" />
                            </StackPanel>
                            <StackPanel x:Name="SticksPanel" Style="{StaticResource SticksGroup}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="LEFT STICK" Style="{StaticResource Eyebrow}" /><controls:StickPlot Frame="{Binding Frame}" Height="72" /><TextBlock Style="{StaticResource Mono}"><Run Text="X " /><Run Text="{Binding LX, Mode=OneWay}" /></TextBlock><TextBlock Style="{StaticResource Mono}" Margin="0,3,0,0"><Run Text="Y " /><Run Text="{Binding LY, Mode=OneWay}" /></TextBlock></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="RIGHT STICK" Style="{StaticResource Eyebrow}" /><controls:StickPlot Frame="{Binding Frame}" Right="True" Height="72" /><TextBlock Style="{StaticResource Mono}"><Run Text="X " /><Run Text="{Binding RX, Mode=OneWay}" /></TextBlock><TextBlock Style="{StaticResource Mono}" Margin="0,3,0,0"><Run Text="Y " /><Run Text="{Binding RY, Mode=OneWay}" /></TextBlock></StackPanel>
                                </Grid>
                                <TextBlock Text="Signed axes · full range −32768…32767" Style="{StaticResource SecondaryCopy}" FontSize="11" Margin="0,7,0,10" />
                            </StackPanel>
                            <StackPanel x:Name="TriggersPanel" Style="{StaticResource TriggersGroup}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:TriggerMeter Label="LT" Value="{Binding Frame.LT}" /><controls:TriggerMeter Grid.Column="2" Label="RT" Value="{Binding Frame.RT}" /></Grid><TextBlock Text="Open Sticks for axis plots and raw values." Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,19,0,0" Visibility="{Binding IsCompact, Converter={StaticResource BoolVisibility}}" /></StackPanel>
                            <StackPanel x:Name="SignalPanel" Style="{StaticResource SignalGroup}">
                                <TextBlock Text="Independent input paths" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,8" />
                                <TextBlock Text="A static interface is not proof that the controller sends zeros." Style="{StaticResource SecondaryCopy}" Margin="0,0,0,16" />
                                <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,12,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Color}" FontSize="10" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="Interface association remains unverified. These candidate streams are simulated." Style="{StaticResource SecondaryCopy}" FontSize="12" Margin="0,17,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,19,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSegment}" Value="Buttons"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding SelectedSegment}" Value="Signal"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="RECENT TRANSITIONS" Style="{StaticResource Eyebrow}" /><ItemsControl ItemsSource="{Binding Events}" MaxHeight="180" ClipToBounds="True" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="Host observations only · no hardware verdict" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,13,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0"><TextBlock Text="SIMULATION SCENARIO" Style="{StaticResource Eyebrow}" Margin="0,0,0,5" /><ComboBox x:Name="ScenarioChoice" ItemsSource="{Binding ScenarioNames}" SelectedIndex="0" SelectionChanged="ScenarioChanged" AutomationProperties.Name="Simulation scenario" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="SELECTED SOURCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Slots}" SelectedIndex="{Binding Slot, Mode=TwoWay}" AutomationProperties.Name="Simulated XInput slot" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,18,0"><TextBlock Text="READER (PREVIEW)" Style="{StaticResource Eyebrow}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Readers}" SelectedItem="{Binding Reader, Mode=TwoWay}" AutomationProperties.Name="Simulated Windows reader" /></StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center"><CheckBox Content="Pause preview" IsChecked="{Binding Paused, Mode=TwoWay}" Margin="0,2,0,6" /><CheckBox Content="Reduced motion" IsChecked="{Binding ReducedMotion, Mode=TwoWay}" /><CheckBox Content="Capture owns input" IsChecked="{Binding CaptureOwnsInput, Mode=TwoWay}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
