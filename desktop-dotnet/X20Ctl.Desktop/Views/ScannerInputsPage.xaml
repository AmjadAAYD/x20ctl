<UserControl x:Class="X20Ctl.Desktop.Views.ScannerInputsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:X20Ctl.Desktop.Controls" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Themes/ScannerSceneTheme.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="AxisFigure" TargetType="TextBlock"><Setter Property="FontFamily" Value="Bahnschrift, Segoe UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#DAE6F9" /></Style>
            <Style x:Key="PlotSize" TargetType="controls:StickPlot"><Setter Property="Height" Value="126" /><Setter Property="Instrument" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Height" Value="96" /></DataTrigger></Style.Triggers></Style>
            <Style x:Key="PlotGroup" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSegment}" Value="Inputs"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding SelectedSegment}" Value="Sticks"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            <Style x:Key="GaugeGroup" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSegment}" Value="Inputs"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding SelectedSegment}" Value="Triggers"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="32,12,32,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="59*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="41*" /></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10"><TextBlock Text="INPUT TESTER / EASYSMX X20" Style="{StaticResource SceneEyebrow}" Margin="0,0,0,5" /><TextBlock Text="See every input." FontSize="34" FontWeight="SemiBold" /><TextBlock Text="Move the sticks, squeeze triggers, press any button." FontSize="15" Foreground="#A5BAD8" Margin="0,6,0,0" /></StackPanel>
                <Grid Grid.Row="1" Margin="-12,0,-8,0">
                    <Ellipse Width="540" Height="56" VerticalAlignment="Bottom" Margin="0,0,0,13"><Ellipse.Fill><RadialGradientBrush RadiusX="0.6" RadiusY="0.48"><GradientStop Color="#CF00030C" Offset="0" /><GradientStop Color="#0000030C" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                    <Ellipse Width="430" Height="70" VerticalAlignment="Bottom" Margin="-130,0,0,7"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#402158C5" Offset="0" /><GradientStop Color="#001641BD" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                    <Ellipse Width="210" Height="58" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,15"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#28D98234" Offset="0" /><GradientStop Color="#00D98234" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                    <controls:ControllerVisualizer x:Name="Hero" ScannerScene="True" Frame="{Binding Frame}" />
                </Grid>
            </Grid>
            <Grid Grid.Column="2" x:Name="Telemetry">
                <Border CornerRadius="16" Background="#E80A1121" BorderBrush="{StaticResource ScenePanelEdge}" BorderThickness="0,1,1,0" />
                <Border CornerRadius="16" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3A1D395E" Offset="0" /><GradientStop Color="#00122236" Offset="0.4" /><GradientStop Color="#221F1718" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                <Grid Margin="24,14,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel x:Name="InspectorTabs" Margin="-9,0,-9,14"><RadioButton Content="Inputs" Tag="Inputs" IsChecked="True" GroupName="SceneInspector" Style="{StaticResource SceneSegment}" Checked="SegmentChanged" /><RadioButton Content="Sticks" Tag="Sticks" GroupName="SceneInspector" Style="{StaticResource SceneSegment}" Checked="SegmentChanged" /><RadioButton Content="Buttons" Tag="Buttons" GroupName="SceneInspector" Style="{StaticResource SceneSegment}" Checked="SegmentChanged" /><RadioButton Content="Triggers" Tag="Triggers" GroupName="SceneInspector" Style="{StaticResource SceneSegment}" Checked="SegmentChanged" /><RadioButton Content="Signal" Tag="Signal" GroupName="SceneInspector" Style="{StaticResource SceneSegment}" Checked="SegmentChanged" /></WrapPanel>
                    <ScrollViewer x:Name="InspectorContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="CURRENT INPUT" Style="{StaticResource SceneEyebrow}" />
                            <Grid Margin="0,8,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PressedControl}" FontSize="46" FontWeight="SemiBold" /><Border Background="#1B1ED8AF" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="{Binding InputState}" Foreground="#67DFC0" FontSize="11.5" FontWeight="SemiBold" /></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding HeldDuration}" FontFamily="Bahnschrift, Segoe UI Variable Display" FontSize="54" FontWeight="Light" /><TextBlock Text="s" FontSize="18" Foreground="#99B4D4" VerticalAlignment="Bottom" Margin="7,0,0,10" /></StackPanel></Grid>
                            <TextBlock Text="{Binding LastRelease}" FontSize="12.5" Foreground="#9AAEC9" Margin="0,0,0,14" />
                            <Border Height="1" Background="#203C5A83" Margin="0,0,0,16" />
                            <Grid Style="{StaticResource PlotGroup}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="LEFT STICK" Style="{StaticResource SceneEyebrow}" /><controls:StickPlot Frame="{Binding Frame}" Style="{StaticResource PlotSize}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="20" /></Grid.RowDefinitions><TextBlock Text="X" FontSize="12" Foreground="#7C9CC2" /><TextBlock Grid.Column="1" Text="{Binding LX}" Style="{StaticResource AxisFigure}" HorizontalAlignment="Right" /><TextBlock Grid.Row="1" Text="Y" FontSize="12" Foreground="#7C9CC2" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LY}" Style="{StaticResource AxisFigure}" HorizontalAlignment="Right" /></Grid></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="RIGHT STICK" Style="{StaticResource SceneEyebrow}" /><controls:StickPlot Frame="{Binding Frame}" Right="True" Style="{StaticResource PlotSize}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="20" /></Grid.RowDefinitions><TextBlock Text="X" FontSize="12" Foreground="#7C9CC2" /><TextBlock Grid.Column="1" Text="{Binding RX}" Style="{StaticResource AxisFigure}" HorizontalAlignment="Right" /><TextBlock Grid.Row="1" Text="Y" FontSize="12" Foreground="#7C9CC2" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RY}" Style="{StaticResource AxisFigure}" HorizontalAlignment="Right" /></Grid></StackPanel>
                            </Grid>
                            <StackPanel Style="{StaticResource GaugeGroup}" Margin="0,17,0,0">
                                <DockPanel Margin="0,0,0,8"><TextBlock Text="LT" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Frame.LT, StringFormat={}{0} / 255}" FontFamily="Bahnschrift, Segoe UI" Foreground="#C9DBEF" HorizontalAlignment="Right" /></DockPanel><controls:AnalogBar Value="{Binding Frame.LT}" ReducedMotion="{Binding ReducedMotion}" Margin="0,0,0,17" />
                                <DockPanel Margin="0,0,0,8"><TextBlock Text="RT" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Frame.RT, StringFormat={}{0} / 255}" FontFamily="Bahnschrift, Segoe UI" Foreground="#C9DBEF" HorizontalAlignment="Right" /></DockPanel><controls:AnalogBar Value="{Binding Frame.RT}" ReducedMotion="{Binding ReducedMotion}" />
                            </StackPanel>
                            <StackPanel Margin="0,18,0,0"><Border Height="1" Background="#203C5A83" Margin="0,0,0,12" /><DockPanel><TextBlock Text="RECENT INPUT" Style="{StaticResource SceneEyebrow}" /><Ellipse Width="5" Height="5" Fill="#66E1BC" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel><ItemsControl ItemsSource="{Binding Events}" MaxHeight="34" ClipToBounds="True" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Bahnschrift, Segoe UI" FontSize="12.5" Foreground="#A6C4E6" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#243C6AA8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{Binding ConnectionColor}" Margin="0,0,9,0" VerticalAlignment="Center" /><TextBlock Text="{Binding SceneSource}" FontSize="12.5" Foreground="#9EBEE3" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border CornerRadius="5" BorderBrush="#375F80AF" BorderThickness="1" Padding="5,2"><TextBlock Text="LB / RB" FontSize="11.5" Foreground="#ABC6E7" /></Border><TextBlock Text=" Tabs" FontSize="12" Foreground="#829CBE" Margin="0,0,18,0" /><Ellipse Width="16" Height="16" Fill="#142CCA9F" Stroke="#627ECDAC" StrokeThickness="1" /><TextBlock Text=" A · Select" FontSize="12" Foreground="#A6C9C9" Margin="0,0,16,0" /><TextBlock Text="B · Back" FontSize="12" Foreground="#A6ADC3" /></StackPanel><TextBlock Grid.Column="2" Text="SIMULATION" FontSize="11.5" Foreground="#8294B1" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
        <Border x:Name="DeveloperDrawer" Grid.RowSpan="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,52" Background="#FC0B1529" BorderBrush="#54769CCB" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel><TextBlock Text="Developer diagnostics · F12 to close" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox x:Name="ScenarioChoice" ItemsSource="{Binding ScenarioNames}" SelectedIndex="0" SelectionChanged="ScenarioChanged" AutomationProperties.Name="Simulation scenario" /><ComboBox Grid.Column="2" ItemsSource="{Binding Slots}" SelectedIndex="{Binding Slot, Mode=TwoWay}" AutomationProperties.Name="Selected simulated source" /><ComboBox Grid.Column="4" ItemsSource="{Binding Readers}" SelectedItem="{Binding Reader, Mode=TwoWay}" AutomationProperties.Name="Simulated Windows reader" /></Grid><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><CheckBox Content="Pause simulation" IsChecked="{Binding Paused, Mode=TwoWay}" Margin="0,0,24,0" /><CheckBox Content="Reduced motion" IsChecked="{Binding ReducedMotion, Mode=TwoWay}" Margin="0,0,24,0" /><CheckBox Content="Capture owns input" IsChecked="{Binding CaptureOwnsInput, Mode=TwoWay}" /></StackPanel></StackPanel></Border>
    </Grid>
</UserControl>
