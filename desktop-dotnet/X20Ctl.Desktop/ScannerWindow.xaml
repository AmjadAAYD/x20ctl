<local:ConsoleWindow x:Class="X20Ctl.Desktop.ScannerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:X20Ctl.Desktop" xmlns:controls="clr-namespace:X20Ctl.Desktop.Controls" xmlns:views="clr-namespace:X20Ctl.Desktop.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="X20CTL · Controller Scanner" Width="1264" Height="844" MinWidth="1120" MinHeight="780" AllowsTransparency="True" Background="Transparent">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/ScannerSceneTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="Transparent">
        <Border Margin="20" CornerRadius="22" Background="#050915"><Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="5" Color="#00020A" Opacity="0.75" /></Border.Effect></Border>
        <Border x:Name="ConsoleFrame" Margin="20" CornerRadius="22" BorderThickness="1">
            <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8F387DDA" Offset="0" /><GradientStop Color="#31364D76" Offset="0.55" /><GradientStop Color="#8D9A663E" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
            <Grid x:Name="Scene" ClipToBounds="True" TextOptions.TextFormattingMode="Display">
                <controls:ScannerEnvironment />
                <Grid><Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="28,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" CornerRadius="9" Background="#BB0D1930" BorderBrush="#487BA9E9" BorderThickness="1" Margin="0,0,14,0"><Image Source="/Assets/brand-mark.png" Width="26" Height="26" /></Border><TextBlock Text="X20CTL" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Width="1" Height="20" Background="#314E6996" Margin="20,0,17,0" /><TextBlock Text="Controller Scanner" FontSize="14" Foreground="#A7C1E3" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border CornerRadius="16" Padding="13,7" Background="#1D30D4A3" BorderBrush="#443ED7A5" BorderThickness="1" Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{Binding ConnectionColor}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="{Binding SceneStatus}" Foreground="{Binding ConnectionColor}" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border><Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" /><Button Content="□" Style="{StaticResource ChromeButton}" Click="MaximizeRestore" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize or restore" /><Button Content="×" Style="{StaticResource ChromeButton}" Click="CloseWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="32,0,32,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border CornerRadius="12" BorderBrush="#47708FBF" BorderThickness="1" Padding="9,3" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="LB" FontSize="12" Foreground="#B5CAE5" /></Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton Content="Device" Style="{StaticResource SceneNav}" IsEnabled="False" /><RadioButton Content="Inputs" Style="{StaticResource SceneNav}" IsChecked="True" /><RadioButton Content="Controls" Style="{StaticResource SceneNav}" IsEnabled="False" /><RadioButton Content="Features" Style="{StaticResource SceneNav}" IsEnabled="False" /><RadioButton Content="Performance" Style="{StaticResource SceneNav}" IsEnabled="False" /><RadioButton Content="Results" Style="{StaticResource SceneNav}" IsEnabled="False" /><RadioButton Content="Advanced" Style="{StaticResource SceneNav}" IsEnabled="False" /></StackPanel>
                        <Border Grid.Column="2" CornerRadius="12" BorderBrush="#47708FBF" BorderThickness="1" Padding="9,3" VerticalAlignment="Center"><TextBlock Text="RB" FontSize="12" Foreground="#B5CAE5" /></Border>
                    </Grid>
                    <views:ScannerInputsPage x:Name="InputView" Grid.Row="2" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</local:ConsoleWindow>
