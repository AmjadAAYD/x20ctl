<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF4FF" /><Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" /><Setter Property="FontSize" Value="14" /></Style>
    <Style x:Key="SceneEyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="#91AED3" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="SceneCopy" TargetType="TextBlock"><Setter Property="Foreground" Value="#A9BDD9" /><Setter Property="FontSize" Value="14" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="SceneNav" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" /><Setter Property="FontSize" Value="16" /><Setter Property="Foreground" Value="#91A7CA" /><Setter Property="Margin" Value="0,0,26,0" /><Setter Property="Padding" Value="0,12,0,12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Background="Transparent"><TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" /><Border x:Name="Line" Height="2" Width="44" Background="#75D3FF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0"><Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="0" Color="#248FFF" Opacity="0.85" /></Border.Effect></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Line" Property="Opacity" Value="1" /><Setter TargetName="Label" Property="Foreground" Value="#F2F8FF" /><Setter TargetName="Label" Property="FontWeight" Value="SemiBold" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SceneSegment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#91A7CA" /><Setter Property="Padding" Value="11,9" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Face" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}"><TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#334F83BC" /><Setter TargetName="Label" Property="Foreground" Value="#F3F8FF" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="Foreground" Value="White" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <LinearGradientBrush x:Key="ScenePanel" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EA13223B" Offset="0" /><GradientStop Color="#ED091226" Offset="0.57" /><GradientStop Color="#E51A1925" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="ScenePanelEdge" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#583868A4" Offset="0" /><GradientStop Color="#15245184" Offset="0.5" /><GradientStop Color="#427C5E49" Offset="1" /></LinearGradientBrush>
</ResourceDictionary>
