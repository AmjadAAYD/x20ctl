<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../X20Ctl.Simulation/X20Ctl.Simulation.csproj" /></ItemGroup>
  <!-- offline mode's phrasebook and pre-trained audio/SFX haptics weights -->
  <ItemGroup>
    <EmbeddedResource Include="Agent/phrasebook.json" LogicalName="X20Ctl.Zone.Agent.phrasebook.json" Condition="Exists('Agent/phrasebook.json')" />
    <EmbeddedResource Include="Lighting/HapticsModelWeights.json" LogicalName="X20Ctl.Zone.Lighting.HapticsModelWeights.json" Condition="Exists('Lighting/HapticsModelWeights.json')" />
  </ItemGroup>
</Project>
