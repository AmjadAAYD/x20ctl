<Project Sdk="Microsoft.NET.Sdk">
  <!-- X20CTL for Android phones: the Linux Studio (X20Ctl.Linux, the Avalonia copy of the Windows app) running in a
       phone view. Its source files are compiled in as they are; this project adds the Android shell around them. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- the shared screens load their art as avares://x20ctl-studio/... -->
    <AssemblyName>x20ctl-studio</AssemblyName>
    <RootNamespace>X20Ctl.Droid</RootNamespace>
    <ApplicationId>io.github.amjadaayd.x20ctl</ApplicationId>
    <ApplicationTitle>X20CTL</ApplicationTitle>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <!-- the Studio's About and update check read this; it is the desktop release the phone app was made from -->
    <Version>0.18.0</Version>
    <InformationalVersion>0.018</InformationalVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- the shared code serialises with reflection; keep every type -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- the plain .NET implicit usings only: the Android SDK's own (Android.App, Android.Widget...) clash with Avalonia's
         names (Application, CheckBox) in the shared screens, and the Android files here name their namespaces themselves -->
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../X20Ctl.Zone/X20Ctl.Zone.csproj" />
    <!-- every screen of the Linux Studio; its desktop entry point and tray-icon App are replaced by PhoneApp.cs -->
    <Compile Include="../X20Ctl.Linux/*.cs" Exclude="../X20Ctl.Linux/Program.cs;../X20Ctl.Linux/App.cs" Link="Studio/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../src/assets/controllers/*/native/front-full.png;../../src/assets/controllers/*/native/rear-full.png" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../X20Ctl.Product/Brand/x20ctl-mark.png" Link="Assets/x20ctl-mark.png" />
    <AvaloniaResource Include="../X20Ctl.Product/Brand/x20ctl-icon.png" Link="Assets/x20ctl-icon.png" />
    <!-- the files the desktop build copies next to the program; unpacked on first launch (ContentUnpacker.cs) -->
    <AndroidAsset Include="../../x20ctl/controllers/catalog.json" Link="Assets/Data/catalog.json" />
    <AndroidAsset Include="../../src/assets/controllers/framing.json" Link="Assets/Data/framing.json" />
    <AndroidAsset Include="../../src/assets/controllers/vibration-outlines.json" Link="Assets/Data/vibration-outlines.json" />
    <!-- the phone's lighter copy of the film (tools/linux-studio/build_intro_film.py --phone) -->
    <AndroidAsset Include="Brand/intro-film.frames" Link="Assets/Brand/intro-film.frames" />
    <AndroidAsset Include="../X20Ctl.Linux/Brand/intro-film.wav" Link="Assets/Brand/intro-film.wav" />
  </ItemGroup>
</Project>
