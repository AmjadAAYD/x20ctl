#include <winres.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/../../desktop-dotnet/X20Ctl.Product/Brand/x20ctl.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/setup.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @X20_VERSION_COMMAS@
 PRODUCTVERSION @X20_VERSION_COMMAS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "X20CTL"
      VALUE "FileDescription", "X20CTL setup"
      VALUE "FileVersion", "@X20_VERSION@"
      VALUE "ProductVersion", "@X20_NAME@"
      VALUE "OriginalFilename", "X20CTL-@X20_NAME@-windows-x64-setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
